<?xml version="1.0" encoding="utf-8"?>
<!-- A developer's browser: plain HTTP (local dev servers, devices on the LAN) and user-installed
     CAs (Charles, mitmproxy, a company proxy) both work. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
